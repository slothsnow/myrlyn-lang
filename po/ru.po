msgstr "Отменить все изменения и выйти?"

#: libyui-qt-pkg/src/YQPackageSelectorBase.cc:235
msgid "&Yes"
msgstr "&Да"

#: libyui-qt-pkg/src/YQPackageSelectorBase.cc:235
