#: YQPkgVersionsView.cc:399
msgid ""
"You are trying to install multiversion-capable\n"
"and non-multiversion-capable versions of this\n"
"package at the same time."
msgstr ""
"Si sta tentando di installare contemporaneamente versioni multiversione\n"
"e non del\n"
"pacchetto."

#: YQPkgVersionsView.cc:407
msgid ""
"This version is multiversion-capable.\n"
"\n"
"Press \"Continue\" to install this version\n"
"and unselect the non-multiversion-capable version,\n"
"\"Cancel\" to unselect this version and keep the other one."
msgstr ""
"Questa è una versione multiversione.\n"
"\n"
"Premere \"Continua\" per installarla\n"
"e deselezionare la versione non multiversione, fare clic su\n"
"\"Annulla\" per deselezionare la versione e mantenere l'altra."

#: YQPkgVersionsView.cc:416
msgid ""
"This version is not multiversion-capable.\n"
"\n"
"Press \"Continue\" to install only this version\n"
"and unselect all other versions,\n"
"\"Cancel\" to unselect this version and keep the other ones."
msgstr ""
"Questa non è una versione multiversione.\n"
"\n"
"Premere \"Continua\" per installare solo questa versione\n"
"e deselezionare tutte le altre, fare clic su\n"
"\"Annulla\" per deselezionare la versione e mantenere le altre."

